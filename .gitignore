# Raw generated art. These are concept sources, not sprites — hundreds of KB
# each, and ~100x heavier than what ships. `npm run art:clean` reduces them
# into public/, and those cleaned sprites are what is committed.
art-source

# Raw music. Source tracks are 256-320kbps masters of several megabytes;
# `npm run audio:clean` transcodes them into public/sound/music, and those
# transcoded files are what is committed.
audio-source

# Raw video. The shift clip arrives full length and full size;
# `npm run video:clean` trims and transcodes it into public/animation.
video-source

