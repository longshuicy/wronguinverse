{
  "name": "wronguinverse",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "art:clean": "node scripts/clean-sprites.mjs",
    "art:check": "node scripts/clean-sprites.mjs --check",
    "audio:clean": "node scripts/clean-audio.mjs",
    "audio:check": "node scripts/clean-audio.mjs --check",
    "video:clean": "node scripts/clean-video.mjs",
    "video:check": "node scripts/clean-video.mjs --check"
  },
  "dependencies": {
    "howler": "^2.2.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/howler": "^2.2.12",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "jsdom": "^25.0.1",
    "oxlint": "^1.79.0",
    "prettier": "^3.4.2",
    "sharp": "^0.35.4",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
